        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MCSim.MainWindow"
        xmlns:local="clr-namespace:MCSim"
        x:DataType="local:MainWindowViewModel"
        Title="MCSim">
    <Grid ColumnDefinitions="Auto,*" >
